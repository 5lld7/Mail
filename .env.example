# Copy to /etc/mail-panel.env on the server; do not commit credentials.
PANEL_MODE=cyberpanel
PANEL_HOST=127.0.0.1
PANEL_PORT=8095
PANEL_PASSWORD_HASH=replace-with-generated-hash
PANEL_SECRET=replace-with-random-secret
PANEL_DOMAINS=example.com
# Set to 1 when using an HTTPS reverse proxy. Loopback SSH tunnels use 0.
PANEL_SECURE_COOKIE=0
PANEL_CYBER_PYTHON=/usr/local/CyberCP/bin/python
